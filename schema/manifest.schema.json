{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/ARPL/schema/manifest.schema.json",
  "title": "ARPL instruction pack manifest",
  "type": "object",
  "required": [
    "id",
    "title",
    "use_when",
    "level",
    "work_class",
    "workflows",
    "disciplines",
    "project_types",
    "phases",
    "revit_versions_tested",
    "status",
    "contributors"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ARPL-[A-Z]{2,4}-[0-9]{4}$"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "work_class": {
      "type": "string",
      "pattern": "^W[1-8]$"
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "First entry is the library folder; values from vocabularies.workflows"
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "revit_versions_tested": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^20[0-9]{2}$"
      },
      "description": "Only versions in which the pack actually ran"
    },
    "environment": {
      "type": "object"
    },
    "domain_overlays": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FP[0-9]{2}$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "reproduced",
        "verified",
        "deprecated"
      ]
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "recorded": {
      "type": "string"
    },
    "legacy_id": {
      "type": "string"
    },
    "use_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Trigger sentences: the situations in which an agent should apply this pack"
    },
    "not_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Situations that look similar but where this pack does not apply"
    },
    "api_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Revit API classes, methods or parameters involved, for lookup from code"
    }
  }
}